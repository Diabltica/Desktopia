(version 1)
# Desktopia motherboard: custom DRC rules (KiCad 10). Generated with the net classes, see hardware/desktopia/README.md,
# "PCB rules". Board: 2 layers, FR-4 1.6 mm, 1 oz (35 um) outer copper, HASL, green solder mask, tented vias: JLCPCB.
#
# Where each value lives:
# - Board Setup > Constraints: JLCPCB's absolute minimums (0.10 mm track and gap, 0.45 mm / 0.2 mm via, 0.2 mm hole
#   to hole and hole to copper, 0.3 mm copper to edge, 0.1 mm solder mask web, 1 mm / 0.15 mm silkscreen text).
# - Board Setup > Net Classes: the routing values of each class (track width, clearance, via, differential pair).
# - This file: what the net classes cannot say (minimum width and via size per class, holes, exceptions).
# A clearance rule here overrides the net class clearance for the items it matches, so the only clearance rules are
# the exceptions at the end.
#
# Sources: JLCPCB PCB capabilities, https://jlcpcb.com/capabilities/pcb-capabilities (read November 2026);
# IPC-2221B table 6-1 (conductor spacing) and section 6.2 (current capacity).

### Manufacturing (JLCPCB, 2 layers, 1 oz)

(rule "Track width, any net (JLCPCB 0.10 mm, kept at 0.15 mm)"
	(condition "A.Type == 'Track'")
	(constraint track_width (min 0.15mm))
)

# Vias: 0.3 mm hole / 0.6 mm pad at least. JLCPCB makes 0.15 mm holes, but charges extra under 0.2 mm, and
# for 0.2-0.25 mm holes in pads under 0.45 mm; it asks for a pad 0.1 mm (0.15 mm preferred) over the hole.

(rule "Via size (no extra cost, 0.15 mm ring)"
	(condition "A.Type == 'Via'")
	(constraint via_diameter (min 0.6mm))
	(constraint hole_size (min 0.3mm))
	(constraint annular_width (min 0.15mm))
)

(rule "Hole size (JLCPCB drills 0.2 to 6.3 mm)"
	(constraint hole_size (min 0.2mm) (max 6.3mm))
)

(rule "NPTH hole (JLCPCB 0.5 mm minimum)"
	(condition "!A.isPlated()")
	(constraint hole_size (min 0.5mm))
)

# PTH pads: annular ring 0.18 mm minimum, 0.25 mm recommended. The 0.2 mm thermal vias in the exposed pads
# of U2 / U7 are vias for JLCPCB (0.1 mm over the hole) and are left out.

(rule "PTH pad annular ring (JLCPCB 0.18 mm)"
	(condition "A.Type == 'Pad' && A.isPlated() && A.Hole_Size_X > 0.3mm")
	(constraint annular_width (min 0.18mm))
)

# Holes of one footprint (the via ring of a mounting hole) keep the 0.2 mm of Board Setup (JLCPCB via holes).

(rule "Hole to hole, pads (JLCPCB 0.45 mm)"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Parent != B.Parent")
	(constraint hole_to_hole (min 0.45mm))
)

(rule "PTH hole to track (JLCPCB 0.28 mm, 0.35 mm recommended)"
	(condition "A.Type == 'Pad' && A.isPlated() && B.Type == 'Track' && A.Net != B.Net")
	(constraint hole_clearance (min 0.35mm))
)

(rule "Silkscreen text (JLCPCB 1 mm, 0.15 mm stroke)"
	(layer "?.Silkscreen")
	(condition "A.Type == 'Text' || A.Type == 'Text Box'")
	(constraint text_height (min 1mm))
	(constraint text_thickness (min 0.15mm))
)

(rule "Pad to silkscreen (JLCPCB 0.15 mm)"
	(layer outer)
	(condition "A.Type == 'Pad' && B.Layer == '?.Silkscreen'")
	(constraint silk_clearance (min 0.15mm))
)


### Net classes: minimum track width and via size (the routing width is the net class value)

(rule "Power_24V: track >= 0.25 mm (routing width 3 mm)"
	(condition "A.Type == 'Track' && A.hasNetclass('Power_24V')")
	(constraint track_width (min 0.25mm))
)

# Power_24V vias: the net class routes 1.0 / 0.5 mm, the DRC minimum is the 0.6 / 0.3 mm of every via, because the
# class also covers branches that carry no current: OUT1 / OUT2 to the U7 SH1 / SH2 sense pins, VM to U7 pin VM and
# C28. Like the track width, count the vias of the 15 A path by eye (11 x 1.0 / 0.5 mm per layer change).

(rule "Switch_node: track >= 0.6 mm (routing width 1 mm)"
	(condition "A.Type == 'Track' && A.hasNetclass('Switch_node')")
	(constraint track_width (min 0.6mm))
)

(rule "Switch_node: via >= 0.8 / 0.4 mm"
	(condition "A.Type == 'Via' && A.hasNetclass('Switch_node')")
	(constraint via_diameter (min 0.8mm))
	(constraint hole_size (min 0.4mm))
)

(rule "Power_5V: track >= 0.3 mm (routing width 0.5 mm)"
	(condition "A.Type == 'Track' && A.hasNetclass('Power_5V')")
	(constraint track_width (min 0.3mm))
)

(rule "Power_5V: via >= 0.8 / 0.4 mm"
	(condition "A.Type == 'Via' && A.hasNetclass('Power_5V')")
	(constraint via_diameter (min 0.8mm))
	(constraint hole_size (min 0.4mm))
)

(rule "Power_2V8: track >= 0.2 mm (routing width 0.3 mm)"
	(condition "A.Type == 'Track' && A.hasNetclass('Power_2V8')")
	(constraint track_width (min 0.2mm))
)

(rule "Power_3V3: track >= 0.2 mm (routing width 0.3 mm)"
	(condition "A.Type == 'Track' && A.hasNetclass('Power_3V3')")
	(constraint track_width (min 0.2mm))
)

(rule "Power_1V1: track >= 0.2 mm (routing width 0.3 mm)"
	(condition "A.Type == 'Track' && A.hasNetclass('Power_1V1')")
	(constraint track_width (min 0.2mm))
)

(rule "GND: track >= 0.25 mm (routing width 0.5 mm)"
	(condition "A.Type == 'Track' && A.hasNetclass('GND')")
	(constraint track_width (min 0.25mm))
)

(rule "Gate_drive: track >= 0.25 mm (routing width 0.4 mm)"
	(condition "A.Type == 'Track' && A.hasNetclass('Gate_drive')")
	(constraint track_width (min 0.25mm))
)

(rule "HV_signal: track >= 0.2 mm (routing width 0.3 mm)"
	(condition "A.Type == 'Track' && A.hasNetclass('HV_signal')")
	(constraint track_width (min 0.2mm))
)


### Clearance exceptions
# Pads of one footprint keep the maker's land pattern: the INA226 (TSSOP) pins and the DRV8701 pins next to its
# exposed pad are 0.2 mm apart, under the 0.25 mm of the 24 V classes (JLCPCB: 0.15 mm between SMD pads), and the
# GND pads of the USB-C receptacle sit 0.19 mm from its own locating holes.

(rule "Pads of one footprint"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == B.Parent")
	(constraint clearance (min 0.15mm))
	(constraint hole_clearance (min 0.15mm))
)

# Tracks and vias at fine-pitch pins (U6 INA226, U7 DRV8701, J3 USB-C at 0.5 mm, U4 RP2040 at 0.4 mm): a 0.25 mm track
# into a 0.3 mm pad passes 0.225 mm from the next pad; into the 0.2 mm pads of the RP2040, route 0.2 mm tracks (0.2 mm
# gap; a 0.3 mm 3V3 / 1V1 track still leaves 0.15 mm). The charge pump and regulator capacitors of U7 (C29-C32, 0402)
# sit against its pins: tracks and vias may pass 0.15 mm from their pads too. The copper is under solder mask (IPC-2221B B4: 0.05 mm up to 30 V, 0.13 mm
# up to 50 V); JLCPCB: 0.1 mm.

(rule "Escape from fine-pitch pins"
	(condition "(A.Type == 'Track' || A.Type == 'Via') && (A.intersectsCourtyard('U4') || A.intersectsCourtyard('U6') || A.intersectsCourtyard('U7') || A.intersectsCourtyard('J3'))")
	(constraint clearance (min 0.15mm))
)

(rule "Pads of the U7 capacitors (C29-C32)"
	(condition "(A.Type == 'Track' || A.Type == 'Via') && B.Type == 'Pad' && (B.memberOfFootprint('C29') || B.memberOfFootprint('C30') || B.memberOfFootprint('C31') || B.memberOfFootprint('C32'))")
	(constraint clearance (min 0.15mm))
)

# Copper under the solder mask: tracks and (tented) vias of two nets 0.15 mm apart, whatever their class. The 0.25 mm of
# the 24 V classes is for bare copper (IPC-2221B A6, pads); between coated conductors B4 asks for 0.05 mm up to 30 V and
# 0.13 mm up to 50 V (the gate and charge pump nets, VM + 10.5 V), JLCPCB for 0.10 mm. Without it the gate, charge
# pump and Kelvin sense tracks cannot pass each other between U7, the four FETs and the shunts. Pads and zones keep
# the net class (and zone) clearance.

(rule "Coated copper: track and via to track and via"
	(condition "(A.Type == 'Track' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Via') && A.Net != B.Net")
	(constraint clearance (min 0.15mm))
)
