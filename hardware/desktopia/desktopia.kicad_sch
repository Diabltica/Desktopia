	(text "J4 pin-out (6P6C, straight or reversed cord):\n1 = +5V   2 = GND   3 = A   4 = B   5 = GND   6 = +5V\nA reversed cord only swaps A and B: the HMI board detects it.\nNever plug J4 into a telephone wall socket."
		(exclude_from_sim no)
		(at 336.55 135.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0593e069-0146-4639-9e25-a71eab87fed4")
	)
	(text "24 V supply input, 24 A screw terminal\n(it carries the motor current)"
