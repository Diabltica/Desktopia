		(uuid "93c41344-fbcb-43eb-9181-99fd81ac1e64")
	)
	(text "MOTOR_PWR high: Q5 on (Vgs -12 V). R22 keeps it off in reset.\nC21 / R20: ~15 ms soft start. Cut only with the PWM at 0."
		(exclude_from_sim no)
		(at 33.02 191.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a2d6e9f6-e774-4658-8ff5-93a033c51f52")
	)
	(text "INA226: I2C address 0x40 (A0 = A1 = GND), alert on PE6.\nR23 2 mOhm: +-41 A full scale, 1.25 mA resolution, 0.34 W at 13 A.\nKelvin-connect Vin+ / Vin- right at the R23 pads. +24V / MOTOR_24V / MOTOR_SW:\ncopper for 15 A (pours, or >= 5 mm in 1 oz)."
		(exclude_from_sim no)
		(at 17.78 265.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a935856b-87ff-4829-b8dd-1daa0b50b38f")
	)
	(text "Ceramic output compensation (TI SLVA237):\nL1 22 uH, C7 + C8 2 x 47 uF: f_LC ~ 4.7 kHz.\nC4 / R9 / C12 / C11: crossover 14-27 kHz,\nphase margin > 60 deg, 0.1 to 1.5 A."
		(exclude_from_sim no)
		(at 135.382 83.82 0)
		(effects
			(font
