		(uuid "1819542b-7fa3-484a-a5ce-5eefd8a54990")
	)
	(text "INA226: I2C address 0x40 (A0 = A1 = GND), alert on PE6.\nR25 2 mOhm: +-41 A full scale, 1.25 mA resolution, 0.34 W at 13 A.\nKelvin-connect Vin+ / Vin- right at the R25 pads. +24V / MOTOR_24V:\ncopper for 15 A (pours, or >= 5 mm in 1 oz)."
		(exclude_from_sim no)
		(at 30.48 271.78 0)
