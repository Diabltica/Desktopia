		(uuid "ccb79025-7eaa-4393-9794-6da36b2edd78")
	)
	(text "R14 / R17: bias.  R16 (DNP): 120R termination,\nonly for cords over ~5 m (then R14 / R17 = 680R)."
		(exclude_from_sim no)
		(at 336.55 160.02 0)
