	(text "Q1 / Q2 / Q3 (BSS138, Vgs(th) <= 1.5 V) replace the TXS0104E. 5 V side: SCL, SDA, TOF_INT (PB4 / PCINT4).\nSensor side (2.8 V): SCL, SDA and GPIO1 of U3. A low from the MCU stays under the 0.6 V VIL of the sensor."
		(exclude_from_sim no)
		(at 271.78 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "40bf861a-488a-487f-81d4-0fe4d477cccc")
	)
