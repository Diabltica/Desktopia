	(text "J6 pin-out (6P6C, straight or reversed cord):\n1 = +5V   2 = GND   3 = A   4 = B   5 = GND   6 = +5V\nA reversed cord only swaps A and B: the HMI board detects it.\nNever plug J6 into a telephone wall socket."
		(exclude_from_sim no)
		(at 149.86 222.25 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a2f3d403-3740-4d38-a906-ac2e4fb5d6ae")
	)
	(text "R22 / R23: bias.  R24 (DNP): 120R termination,\nonly for cords over ~5 m (then R22 / R23 = 680R)."
		(exclude_from_sim no)
		(at 198.12 278.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0f16668f-acd9-4611-b401-4e8c30ee610d")
	)
	(text "ENA left open: internal 1.5 MOhm pull-up, 7 V absolute maximum.\nNever tie it to VIN (24 V destroys the TPS5430)."
		(exclude_from_sim no)
		(at 21.59 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d1d23275-8ef9-4a2b-b4f5-9bafe6a76f3d")
	)
