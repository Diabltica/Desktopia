	(text "Link to the motherboard: RS-485 over an RJ11 cord"
		(exclude_from_sim no)
		(at 15.24 24.13 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "f8dc1270-6c82-4179-90e6-d4616d733c30")
	)
	(text "Cord: 6 conductors (6P6C), straight or reversed.\n1 = +5V   2 = GND   3 = A   4 = B   5 = GND   6 = +5V\nSymmetric: a reversed telephone cord cannot swap +5V and GND,\nit only swaps A and B - the firmware detects it and inverts\nthe UART pads (gpio_set_inover / outover)."
		(exclude_from_sim no)
		(at 15.24 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b7dff1f9-808e-4fb7-b804-0b30f31075e8")
	)
	(text "R1 (DNP): 120R termination, only for cords over ~5 m\n(the 4.7k bias resistors on the motherboard then become 680R)"
		(exclude_from_sim no)
		(at 101.6 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "16ca2ed9-99a0-46ac-99bd-14303ad588e5")
	)
	(text "Power + USB-C (firmware update)"
		(exclude_from_sim no)
		(at 15.24 110.49 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "e3bbde12-dd0a-43c1-b5d9-5b951f688d26")
	)
	(text "D1: the USB-C only powers the board for flashing;\nwith the cord in, the 5 V comes from the motherboard\n(D1 stops it flowing back into the PC)."
		(exclude_from_sim no)
		(at 15.24 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4c65a5bb-fd19-43d4-b13d-32ba7a526905")
	)
	(text "RP2040 + 2 MB QSPI flash"
		(exclude_from_sim no)
		(at 144.78 24.13 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "7ad9ebf5-05a7-46cd-b579-500c4c9fc808")
	)
	(text "C6-C11: IOVDD x6   C12: USB_VDD   C13: ADC_AVDD   C14: VREG_VIN   C15: flash   C16: VREG_VOUT   C17-C18: DVDD x2\n(one per pin, as close to it as possible)"
		(exclude_from_sim no)
		(at 147.32 55.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "66894795-49c9-43b1-9add-33150f727d9c")
	)
	(text "SWD"
		(exclude_from_sim no)
		(at 270.51 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2b115478-da63-4b14-8d6e-d96b3ddcb42e")
	)
	(text "LCD screen connection (GC9A01 module)"
		(exclude_from_sim no)
		(at 292.1 24.13 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "6a073b11-d359-4971-8465-b5cc1e70d970")
	)
	(text "1 = +5V (VCC)\n2 = GND"
		(exclude_from_sim no)
		(at 330.2 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "92fe65bf-b124-458c-a936-affcc254fff4")
	)
	(text "VCC = 5 V as before: the module regulates its own 3.3 V.\nLogic: 3.3 V from the RP2040 (SPI0, 20 MHz)."
		(exclude_from_sim no)
		(at 292.1 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "be76da4b-0412-44e4-9e96-27d9e5b33e71")
	)
	(text "HMI switch"
		(exclude_from_sim no)
		(at 292.1 102.87 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "a57e508d-a4cd-4145-a194-77558e64fda5")
	)
	(text "SW1 Up  SW2 Down  SW3..SW5 presets 1..3\nTo GND, RP2040 internal pull-ups, debounced in firmware."
		(exclude_from_sim no)
		(at 345.44 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "32ed66af-50cf-4d41-bb76-c93e6628c4d3")
	)
	(text "Firmware: hmi_firmware/ (PlatformIO, arduino-pico).\nFirst flash: hold BOOT (SW6), plug the USB-C, release -> USB drive, copy firmware.uf2.\nLink protocol: shared/hmi_link/hmi_protocol.h (250 kbaud, motherboard polls every 10 ms).\nPCB: J1, SW1-SW5, TP2-TP6 keep their footprints; FPC_HMI1 is replaced by J2 (RJ11)."
		(exclude_from_sim no)
		(at 292.1 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0eab3d55-5713-4122-9df9-7c8a936c83b6")
	)
