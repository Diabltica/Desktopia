	(text "C6-C11: IOVDD x6   C12: USB_VDD   C13: ADC_AVDD   C14: VREG_VIN\nC15: flash   C16: VREG_VOUT   C17-C18: DVDD x2\n(one per pin, as close to it as possible)"
		(exclude_from_sim no)
		(at 134.62 53.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "305a21d5-2687-42c8-b043-2886cdcffc6b")
	)
	(text "SWD: TP7 SWCLK, TP8 SWDIO, TP10 GND, TP9 RUN"
		(exclude_from_sim no)
		(at 160.02 168.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6f6ab2d5-0c7e-419a-bced-3eb037818902")
	)
	(text "D1: the USB-C only powers the board for flashing;\nwith the cord in, the 5 V comes from the motherboard\n(D1 stops it flowing back into the PC)."
		(exclude_from_sim no)
		(at 15.24 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "faf8b5c3-6b81-441c-8690-549d6e95e816")
	)
	(text "Power + USB-C (firmware update)"
		(exclude_from_sim no)
		(at 15.24 24.13 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "29c7cf4a-b13f-434b-9ce7-02b279813489")
	)
	(text "RP2040 + 2 MB QSPI flash"
