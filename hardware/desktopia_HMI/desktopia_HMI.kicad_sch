		(uuid "3d4362c5-a882-423f-98d6-c3f2a37ea970")
	)
	(text "LCD screen connection (GC9A01 module)"
		(exclude_from_sim no)
		(at 283.21 154.94 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
