	(text "VCC = 5 V as before: the module regulates its own 3.3 V.\nLogic: 3.3 V from the RP2040 (SPI0, 20 MHz)."
		(exclude_from_sim no)
		(at 292.1 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1163d4d7-e83b-41d3-a7d4-1679ad191993")
	)
	(text "D1: the USB-C only powers the board for flashing;\nwith the cord in, the 5 V comes from the motherboard\n(D1 stops it flowing back into the PC)."
		(exclude_from_sim no)
		(at 15.24 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "15c6ad2a-7e50-4871-88d0-4d3fc4cf927e")
	)
	(text "C6-C11: IOVDD x6   C12: USB_VDD   C13: ADC_AVDD   C14: VREG_VIN   C15: flash   C16: VREG_VOUT   C17-C18: DVDD x2\n(one per pin, as close to it as possible)"
		(exclude_from_sim no)
		(at 147.32 55.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1bef69df-8403-4ef7-86cb-1faccee5a7f2")
	)
	(text "Cord: 6 conductors (6P6C), straight or reversed.\n1 = +5V   2 = GND   3 = A   4 = B   5 = GND   6 = +5V\nSymmetric: a reversed telephone cord cannot swap +5V and GND,\nit only swaps A and B - the firmware detects it and inverts\nthe UART pads (gpio_set_inover / outover).\nJ2: the cord is soldered to the board (no jack: the board sits at 45 deg\nunder the desk edge, the cord leaves flat along the desk). Keep the\nflat order, either direction works. Cable tie through the two slots."
		(exclude_from_sim no)
		(at 15.24 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3e67da8f-8686-436b-be2a-94747a1af608")
	)
	(text "7 = +5V (VCC)\n6 = GND"
		(exclude_from_sim no)
		(at 330.2 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5b287887-9e94-4c58-8efb-74de326b23f8")
	)
	(text "SW1 Up  SW2 Down  SW3..SW5 presets 1..3\nTo GND, RP2040 internal pull-ups, debounced in firmware."
		(exclude_from_sim no)
		(at 345.44 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5d283fd8-68a8-46c7-9c4f-100e1bb67688")
	)
	(text "SWD"
		(exclude_from_sim no)
		(at 270.51 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "601a0f15-4721-4686-930b-06d2d83d3eb0")
	)
	(text "Link to the motherboard: RS-485 over an RJ11 cord"
		(exclude_from_sim no)
		(at 15.24 24.13 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "6fb9f3bc-f0b7-4e1e-b4be-db6f92c18d18")
	)
	(text "LCD screen connection (GC9A01 module)"
		(exclude_from_sim no)
		(at 292.1 24.13 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "70888c31-7481-4304-ba2c-978b6ce40677")
	)
	(text "Firmware: hmi_firmware/ (PlatformIO, arduino-pico).\nFirst flash: hold BOOT (SW6), plug the USB-C, release -> USB drive, copy firmware.uf2.\nLink protocol: shared/hmi_link/hmi_protocol.h (250 kbaud, motherboard polls every 10 ms).\nPCB: J1, SW1-SW5, TP2-TP6 keep their footprints; FPC_HMI1 is replaced by J2 (RJ11)."
		(exclude_from_sim no)
		(at 292.1 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7cf97c48-5a42-446a-b45d-7b983ef7b98e")
	)
	(text "R1 (DNP): 120R termination, only for cords over ~5 m\n(the 4.7k bias resistors on the motherboard then become 680R)"
		(exclude_from_sim no)
		(at 101.6 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7e9b38ac-c8f9-4efa-b542-8782225a859d")
	)
	(text "RP2040 + 2 MB QSPI flash"
		(exclude_from_sim no)
		(at 144.78 24.13 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "8be0a467-781c-4b35-b3f5-5f5e4f13f488")
	)
